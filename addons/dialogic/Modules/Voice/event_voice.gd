@tool
class_name DialogicVoiceEvent
extends DialogicEvent

## Event that allows to set the sound file to use for the next text event.


### Settings

## The path to the sound file.
@export_file var file_path := "":
	set(value):
		if file_path != value:
			file_path = value
			ui_update_needed.emit()
## The volume the sound will be played at.
@export var volume: float = 0
## The audio bus to play the sound on.
@export var audio_bus := "Master"
## Stable identifier used by Voice Partner to match this line across edits.
## Generated by the Voice Partner dock the first time the line is pushed and
## stored in the timeline as `uuid="..."`.
@export var uuid := ""


#region EXECUTE
################################################################################

func _execute() -> void:
	# If Auto-Skip is enabled, we may not want to play voice audio.
	# Instant Auto-Skip will always skip voice audio.
	if (dialogic.Inputs.auto_skip.enabled
	and dialogic.Inputs.auto_skip.skip_voice):
		finish()
		return

	dialogic.Voice.set_file(file_path)
	dialogic.Voice.set_volume(volume)
	dialogic.Voice.set_bus(audio_bus)
	finish()
	# the rest is executed by a text event

#endregion


#region INITIALIZE
################################################################################

func _init() -> void:
	event_name = "Voice"
	event_description = "Allows setting an audio file that will be played along the next text event."
	set_default_color('Color7')
	event_category = "Audio"
	event_sorting_index = 5


## Assign the uuid at save time instead of construction time: Dialogic creates
## new events by duplicating a cached prototype, so a uuid generated in _init
## would be copied to every new event.
func to_text() -> String:
	if uuid.is_empty():
		uuid = _new_uuid()
	return super.to_text()


static func _new_uuid() -> String:
	var bytes := Crypto.new().generate_random_bytes(16)
	bytes[6] = (bytes[6] & 0x0f) | 0x40
	bytes[8] = (bytes[8] & 0x3f) | 0x80
	var hex := ""
	for byte in bytes:
		hex += "%02x" % byte
	return "%s-%s-%s-%s-%s" % [
		hex.substr(0, 8),
		hex.substr(8, 4),
		hex.substr(12, 4),
		hex.substr(16, 4),
		hex.substr(20, 12),
	]

#endregion


#region SAVING/LOADING
################################################################################

func get_shortcode() -> String:
	return "voice"


func get_shortcode_parameters() -> Dictionary:
	return {
		#param_name : property_info
		"path"		: {"property": "file_path", "default": ""},
		"volume"	: {"property": "volume", 	"default": 0},
		"bus"		: {"property": "audio_bus", "default": "Master"},
		"uuid"		: {"property": "uuid", "default": ""}
	}

#endregion


#region EDITOR REPRESENTATION
################################################################################

func build_event_editor() -> void:
	if uuid.is_empty():
		uuid = _new_uuid()
	add_header_edit('file_path', ValueType.FILE, {
			'left_text'		: 'Set',
			'right_text'	: 'as the next voice audio',
			'file_filter'	: "*.mp3, *.ogg, *.wav",
			'placeholder' 	: "Select file",
			'editor_icon' 	: ["AudioStreamPlayer", "EditorIcons"],
			"type": "VoiceAudio"})
	add_header_edit('file_path', ValueType.AUDIO_PREVIEW)
	add_body_edit('volume', ValueType.NUMBER, {'left_text':'Volume:', 'mode':2}, '!file_path.is_empty()')
	add_body_edit('audio_bus', ValueType.SINGLELINE_TEXT, {'left_text':'Audio Bus:'}, '!file_path.is_empty()')
	add_body_edit('uuid', ValueType.SINGLELINE_TEXT, {'left_text':'UUID:'})

#endregion
